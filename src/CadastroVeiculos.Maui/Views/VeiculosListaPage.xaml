<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CadastroVeiculos.Maui.ViewModels"
             xmlns:models="clr-namespace:CadastroVeiculos.Maui.Models"
             x:Class="CadastroVeiculos.Maui.Views.VeiculosListaPage"
             x:DataType="vm:VeiculosListaViewModel"
             Title="Veiculos"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header with filter -->
        <VerticalStackLayout Grid.Row="0" Padding="16,16,16,0" Spacing="12">

            <!-- Title + Filter toggle -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Label Text="Veiculos"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="&#x1F50D; Filtros"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="{StaticResource Primary}"
                        FontSize="12"
                        CornerRadius="8"
                        Padding="12,6"
                        HeightRequest="36"
                        Command="{Binding AlternarFiltroCommand}" />
                <Button Grid.Column="2"
                        Text="+ Novo"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="12"
                        CornerRadius="8"
                        Padding="12,6"
                        HeightRequest="36"
                        Margin="8,0,0,0"
                        Command="{Binding AdicionarCommand}" />
            </Grid>

            <!-- Filters panel -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="Transparent"
                   IsVisible="{Binding FiltroVisivel}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Filtrar veiculos" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource Gray900}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <VerticalStackLayout Spacing="4" Grid.Row="0" Grid.Column="0">
                            <Label Text="Descricao" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Gray200}" Padding="8,4" BackgroundColor="White">
                                <Entry Text="{Binding FiltroDescricao}" Placeholder="Descricao" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Grid.Row="0" Grid.Column="1">
                            <Label Text="Marca" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Gray200}" Padding="8,0" BackgroundColor="White">
                                <Picker ItemsSource="{Binding Marcas}"
                                        SelectedItem="{Binding FiltroMarca}"
                                        Title="Selecione"
                                        FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Grid.Row="1" Grid.Column="0">
                            <Label Text="Modelo" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Gray200}" Padding="8,4" BackgroundColor="White">
                                <Entry Text="{Binding FiltroModelo}" Placeholder="Modelo" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Grid.Row="1" Grid.Column="1">
                            <Label Text="Opcionais" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="{StaticResource Gray200}" Padding="8,4" BackgroundColor="White">
                                <Entry Text="{Binding FiltroOpcionais}" Placeholder="Opcionais" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Pesquisar"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="13"
                                HeightRequest="40"
                                Command="{Binding PesquisarCommand}" />
                        <Button Grid.Column="1"
                                Text="Limpar"
                                BackgroundColor="{StaticResource Gray200}"
                                TextColor="{StaticResource Gray600}"
                                CornerRadius="8"
                                FontSize="13"
                                HeightRequest="40"
                                Command="{Binding LimparFiltrosCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Error -->
            <Frame BackgroundColor="#FEE2E2"
                   CornerRadius="8"
                   Padding="12"
                   BorderColor="#FECACA"
                   IsVisible="{Binding Erro, Converter={StaticResource StringToBoolConverter}}">
                <Label Text="{Binding Erro}" TextColor="#DC2626" FontSize="13" />
            </Frame>
        </VerticalStackLayout>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding Carregando}"
                           IsVisible="{Binding Carregando}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

        <!-- Vehicle list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Veiculos}"
                        IsVisible="{Binding Carregando, Converter={StaticResource InverseBoolConverter}}"
                        Margin="16,12,16,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                    <Label Text="&#x1F697;" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhum veiculo encontrado"
                           FontSize="16"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VeiculoResponse">
                    <Frame BackgroundColor="White"
                           CornerRadius="12"
                           Padding="16"
                           Margin="0,0,0,10"
                           HasShadow="True"
                           BorderColor="Transparent">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                            <Label Text="{Binding Descricao}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />

                            <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,4,0,0">
                                <Frame BackgroundColor="{StaticResource Secondary}"
                                       CornerRadius="4"
                                       Padding="6,2"
                                       HasShadow="False"
                                       BorderColor="Transparent">
                                    <Label Text="{Binding MarcaNome}"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}" />
                                </Frame>
                                <Label Text="{Binding Modelo}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label Grid.Row="2"
                                   Text="{Binding Opcionais}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray400}"
                                   Margin="0,4,0,0"
                                   LineBreakMode="TailTruncation" />

                            <Label Grid.Row="3"
                                   Text="{Binding ValorFormatado}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A"
                                   Margin="0,6,0,0" />

                            <!-- Actions -->
                            <VerticalStackLayout Grid.Column="1" Grid.RowSpan="4"
                                                 VerticalOptions="Center" Spacing="8">
                                <Button Text="&#x270F;"
                                        BackgroundColor="#DBEAFE"
                                        TextColor="{StaticResource Primary}"
                                        CornerRadius="8"
                                        FontSize="14"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeiculosListaViewModel}}, Path=EditarCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="&#x1F5D1;"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#DC2626"
                                        CornerRadius="8"
                                        FontSize="14"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VeiculosListaViewModel}}, Path=ExcluirCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
