<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CadastroVeiculos.Maui.ViewModels"
             x:Class="CadastroVeiculos.Maui.Views.UsuarioFormPage"
             x:DataType="vm:UsuarioFormViewModel"
             Title="Editar Usuario"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Form Card -->
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   Padding="24"
                   HasShadow="True"
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Editar Usuario"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <!-- Error -->
                    <Frame BackgroundColor="#FEE2E2"
                           CornerRadius="8"
                           Padding="12"
                           BorderColor="#FECACA"
                           IsVisible="{Binding Erro, Converter={StaticResource StringToBoolConverter}}">
                        <Label Text="{Binding Erro}" TextColor="#DC2626" FontSize="13" />
                    </Frame>

                    <!-- Login (read-only) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Login" FontSize="13" TextColor="{StaticResource Gray600}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" Padding="12,8" BackgroundColor="{StaticResource Gray100}">
                            <Label Text="{Binding LoginUsuario}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray500}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nome -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome *" FontSize="13" TextColor="{StaticResource Gray600}" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}" Padding="12,8" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                            <Entry Text="{Binding Nome}" Placeholder="Nome do usuario" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Info -->
                    <Frame BackgroundColor="#DBEAFE"
                           CornerRadius="8"
                           Padding="12"
                           BorderColor="#BFDBFE"
                           HasShadow="False">
                        <Label Text="A edicao de login e senha esta restrita ao proprio usuario."
                               FontSize="12"
                               TextColor="{StaticResource Primary}" />
                    </Frame>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="Voltar"
                                BackgroundColor="{StaticResource Gray200}"
                                TextColor="{StaticResource Gray600}"
                                CornerRadius="8"
                                HeightRequest="48"
                                Command="{Binding VoltarCommand}" />
                        <Button Grid.Column="1"
                                Text="{Binding Carregando, Converter={StaticResource LoadingTextSalvarConverter}}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                IsEnabled="{Binding Carregando, Converter={StaticResource InverseBoolConverter}}"
                                Command="{Binding SalvarCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
